## Author: B.Irby (NASA/GSFC), based on the previous CFITSIO Makefile.in

# ---------------------------------------------------------------------------
# JPEG-LS support via CharLS, vendored as a git submodule in charls/.
#
# It is OPTIONAL and detected at build time: a `make distcheck` tarball and a
# clone made without --recursive both lack the submodule, and CFITSIO must
# still build in those cases.  When it is absent, HAVE_CHARLS is undefined and
# imcompress.c compiles the JPEG-LS entry points as clean run-time errors.
#
# CharLS is C++, so the C++ runtime must be linked explicitly (the C driver
# does not), and it must come AFTER -lcharls so the static archive resolves.
# Defined here rather than only in Makefile.in so the flags survive autoreconf.
# ---------------------------------------------------------------------------
CHARLS_DIR = $(top_srcdir)/charls
CHARLS_PRESENT = $(shell test -f $(CHARLS_DIR)/include/charls/charls.h && echo yes)
CHARLS_CXXLIB = $(shell test "`uname -s`" = Darwin && echo -lc++ || echo -lstdc++)
CHARLS_CPPFLAGS = $(if $(CHARLS_PRESENT),-I$(CHARLS_DIR)/include -DHAVE_CHARLS)
CHARLS_LDFLAGS = $(if $(CHARLS_PRESENT),-L$(CHARLS_DIR)/build)
CHARLS_LIBS = $(if $(CHARLS_PRESENT),-lcharls $(CHARLS_CXXLIB))

AM_CPPFLAGS = $(CHARLS_CPPFLAGS)
AM_LDFLAGS = $(CHARLS_LDFLAGS)

lib_LTLIBRARIES = libcfitsio.la

# Dummary library to compile single object file with SSE flags
noinst_LTLIBRARIES = libcfitsio_swapproc.la

# Shared library version suffixes generated by libtool, used below
# for symbolic links:
soname_version = @version_info@
soname_version_lnx = ${soname_version}.0.0

include_HEADERS = fitsio.h fitsio2.h longnam.h drvrsmem.h \
	cfortran.h f77_wrap.h region.h

noinst_HEADERS = drvrgsiftp.h eval_defs.h eval_tab.h group.h grparser.h simplerng.h \
	utilities/fpack.h utilities/fverify.h

F77_WRAPPERS = f77_wrap1.c f77_wrap2.c f77_wrap3.c f77_wrap4.c

GSIFTP_SRC = drvrgsiftp.c

# CHARLS_LIBS goes in LIBS, not LIBADD/LDADD: automake turns literal
# LIBADD/LDADD entries into _DEPENDENCIES, so -lcharls would become a make
# target ('No rule to make target -lcharls').  LIBS is appended at the end
# of the link line, which is also the correct order for a static archive.
LIBS = @LIBS@ $(CHARLS_LIBS)
LIBS_CURL = @LIBS_CURL@

libcfitsio_la_SOURCES =	\
	buffers.c \
	cfileio.c \
	checksum.c \
	drvrfile.c \
	drvrmem.c \
	drvrnet.c \
	drvrsmem.c \
	editcol.c \
	edithdu.c \
	eval_l.c \
	eval_y.c \
	eval_f.c \
	fitscore.c \
	getcol.c \
	getcolb.c \
	getcold.c \
	getcole.c \
	getcoli.c \
	getcolj.c \
	getcolk.c \
	getcoll.c \
	getcols.c \
	getcolsb.c \
	getcoluk.c \
	getcolui.c \
	getcoluj.c \
	getkey.c \
	group.c \
	grparser.c \
	histo.c \
	iraffits.c \
	modkey.c \
	putcol.c \
	putcolb.c \
	putcold.c \
	putcole.c \
	putcoli.c \
	putcolj.c \
	putcolk.c \
	putcoluk.c \
	putcoll.c \
	putcols.c \
	putcolsb.c \
	putcolu.c \
	putcolui.c \
	putcoluj.c \
	putkey.c \
	region.c \
	scalnull.c \
	wcssub.c \
	wcsutil.c \
	imcompress.c \
	quantize.c \
	ricecomp.c \
	pliocomp.c \
	fits_hcompress.c \
	fits_hdecompress.c \
	simplerng.c \
	zcompress.c \
	zuncompress.c

if !NOFORTRAN
libcfitsio_la_SOURCES += $(F77_WRAPPERS)
endif

if !NOGSIFTP
libcfitsio_la_SOURCES += ${GSIFTP_SRC}
endif

libcfitsio_la_CFLAGS = $(AM_CFLAGS) @DEFS@
# ${LIBS} is intentionally NOT listed here: automake appends $(LIBS) to the
# link line automatically, and naming it in LIBADD would make automake treat
# its contents (-lcharls) as a build dependency.
libcfitsio_la_LIBADD = -lm ${LIBS_CURL} libcfitsio_swapproc.la
libcfitsio_la_LDFLAGS = -version-info @version_info@


libcfitsio_swapproc_la_CFLAGS = $(libcfitsio_la_CFLAGS) @SSE_FLAGS@
libcfitsio_swapproc_la_SOURCES = swapproc.c

pkgconfigdir = $(libdir)/pkgconfig
pkgconfig_DATA = cfitsio.pc

# Add symbolic links for compatibility with older configuration:
install-exec-hook:
	@cd $(DESTDIR)$(libdir); \
	if test -f "lib${PACKAGE_NAME}.so.${soname_version_lnx}" -a \
		! -f lib${PACKAGE_NAME}.so.${soname_version}.${PACKAGE_VERSION}; then \
	    $(LN_S) lib${PACKAGE_NAME}.so.${soname_version_lnx} \
		    lib${PACKAGE_NAME}.so.${soname_version}.${PACKAGE_VERSION}; \
	fi; \
	if test -f "lib${PACKAGE_NAME}.${soname_version}.dylib" -a \
		! -f lib${PACKAGE_NAME}.${soname_version}.${PACKAGE_VERSION}.dylib; then \
	    $(LN_S) lib${PACKAGE_NAME}.${soname_version}.dylib \
		    lib${PACKAGE_NAME}.${soname_version}.${PACKAGE_VERSION}.dylib; \
	fi

# UTILITIES: =============================================================

#SUBDIRS = utilities

AUTOMAKE_OPTIONS = subdir-objects

bin_PROGRAMS = \
	cookbook \
	fitscopy \
	fitsverify \
	fpack \
	funpack \
	imcopy \
	smem \
	speed

cookbook_SOURCES = utilities/cookbook.c

fitscopy_SOURCES = utilities/fitscopy.c

fitsverify_CFLAGS = -DSTANDALONE
fitsverify_SOURCES = utilities/ftverify.c utilities/fvrf_data.c \
		     utilities/fvrf_file.c utilities/fvrf_head.c \
		     utilities/fvrf_key.c utilities/fvrf_misc.c

fpack_SOURCES = utilities/fpack.c utilities/fpackutil.c
fpack_LDADD = -lm ${LDADD}

funpack_SOURCES = utilities/funpack.c utilities/fpackutil.c
funpack_LDADD = -lm ${LDADD}

imcopy_SOURCES = utilities/imcopy.c

smem_SOURCES = utilities/smem.c

speed_SOURCES = utilities/speed.c

testprog_SOURCES = utilities/testprog.c

# ${LIBS} omitted deliberately - see libcfitsio_la_LIBADD above.
LDADD = libcfitsio.la

noinst_PROGRAMS = testprog


if !NOFORTRAN

noinst_PROGRAMS+= testf77
testf77_SOURCES = utilities/testf77.f

endif

if BUILD_ITER

noinst_PROGRAMS+= iter_image iter_var
iter_image_SOURCES = utilities/iter_image.c
iter_var_SOURCES = utilities/iter_var.c

endif

# eval: ==================================================================

FLEX =		flex
BISON =		bison

# Tested with bison 3.8 and flex 2.6.4
eval:		# Rebuild eval_* files from flex/bison source
		${FLEX} -o eval_l.c eval.l
		${BISON} -o eval_y.c --header=eval_tab.h eval.y

